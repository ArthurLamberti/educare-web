# Spring Boot API base URL (used only by the Next.js server)
API_URL=http://localhost:8080

# Domain that schools are subdomains of: <school>.<ROOT_DOMAIN>
# Development: open http://demo.localhost:3000 (school "demo" is seeded by the API).
ROOT_DOMAIN=localhost:3000

# VPS (docker-compose.prod.yml, file .env in the app folder):
# API_URL=http://educare-api:8080
# ROOT_DOMAIN=educare.arthurlamberti.com
# WEB_PORT=3002
# IMAGE_TAG=latest
